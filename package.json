  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "test/pages",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
