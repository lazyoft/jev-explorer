{
  "name": "@lazyoft/jev-explorer",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Goal-driven browser exploration with Jev. The code reads, Jev chooses.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jev-explorer": "dist/mcp/main.js"
  },
